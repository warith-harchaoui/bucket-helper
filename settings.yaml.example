# S3-compatible object storage credentials. Copy to settings.yaml and fill in —
# settings.yaml is gitignored so real secrets never get committed.

# Required
s3_access_key: "AKIA-DUMMY-ACCESS-KEY"   # access key ID
s3_secret_key: "your-secret-access-key-here"   # secret access key
s3_bucket: "my-bucket"   # default bucket name
s3_https: "https://my-bucket.s3.eu-west-3.amazonaws.com"   # base public URL for built objects (used by remote_tempfile)

# Optional
s3_region: "eu-west-3"   # AWS region; irrelevant for path-style MinIO etc.
s3_endpoint_url: ""   # custom endpoint for S3-compatible storage (MinIO, R2, B2, Spaces, Wasabi); empty = AWS S3
s3_prefix: ""   # default key prefix, path-like (e.g. "uploads")
s3_use_path_style: "false"   # "true" to force path-style addressing (typical for MinIO with custom domains)
s3_verify_ssl: "true"   # "false" to disable TLS verification (dev MinIO with self-signed cert, use sparingly)
